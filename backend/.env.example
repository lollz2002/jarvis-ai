# Albert OS Backend — Environment Variables
# Copy to .env for local development. Set directly in Railway for production.
# Never commit .env to git.

# ── REQUIRED: AI Providers ────────────────────────────────────────────────────
# At least ONE must be set. App falls back through: openai -> claude -> gemini
OPENAI_API_KEY=sk-proj-...        # GPT-4o, TTS voice, vision — PRIMARY
ANTHROPIC_API_KEY=sk-ant-...      # Claude Sonnet — coding, diagnostics
GEMINI_API_KEY=AIza...            # Gemini Flash — translation, vision fallback
PERPLEXITY_API_KEY=pplx-...       # Real-time research (optional, no fallback)

# ── OPTIONAL: Voice TTS ───────────────────────────────────────────────────────
# Fallback order: OpenAI TTS -> ElevenLabs -> silent (no crash)
ELEVENLABS_API_KEY=               # ElevenLabs fallback TTS
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB

# ── OPTIONAL: Cloud Sync ──────────────────────────────────────────────────────
# If not set: sync is skipped silently, local SQLite still works fully
CLOUD_SYNC_URL=                   # e.g. https://your-app.up.railway.app

# ── OPTIONAL: Device & Security ───────────────────────────────────────────────
DEVICE_ID=albert-server-001       # Server instance ID in sync logs
JWT_SECRET=                       # Future JWT auth (not required for MVP)
BACKUP_ENCRYPTION_KEY=            # Encrypted backup/restore (optional)

# ── OPTIONAL: Personality ─────────────────────────────────────────────────────
JARVIS_NAME=JARVIS
JARVIS_LANGUAGE=ru                # Default language: ru / et / en

# ── Server (Railway sets PORT automatically) ──────────────────────────────────
PORT=8000
