# Albert OS Frontend — Environment Variables
# Copy to .env.local for local dev. Set in Vercel dashboard for production.
# All frontend env vars MUST start with VITE_

# ── REQUIRED: Backend URL ─────────────────────────────────────────────────────
# Points to your Railway backend. Has a hardcoded fallback if not set.
VITE_BACKEND_URL=https://carefree-gentleness-production-6657.up.railway.app
